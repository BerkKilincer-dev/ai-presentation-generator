# Bu dosyayı ".env" adıyla kopyalayıp anahtarınızı yazın.
# Anahtar almak için: https://aistudio.google.com/apikey
GEMINI_API_KEY=buraya-api-anahtarinizi-yazin

# İsteğe bağlı: kullanılacak model (varsayılan: gemini-3.1-flash-lite)
# GEMINI_MODEL=gemini-3.1-flash-lite

# İsteğe bağlı: slaytlara fotoğraf eklemek için Pixabay anahtarı (ücretsiz)
# Anahtar almak için: https://pixabay.com/api/docs/ (giriş yapınca sayfada görünür)
PIXABAY_API_KEY=
